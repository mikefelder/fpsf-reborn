---
import BaseLayout from '@layouts/BaseLayout.astro';
import type { Snapshot } from '@/types/snapshot';
import { canonicalHref } from '@data/show-years';

export interface Props {
  snapshot: Snapshot;
  title?: string;
  description?: string;
  bodyClass?: string;
  // The href of the current page within the live-snapshots list,
  // used for year-pill prev/next navigation.
  currentHref?: string;
}

const {
  snapshot,
  title,
  description,
  bodyClass = 'index',
  currentHref,
} = Astro.props;

const data = snapshot;
const pageTitle = title ?? data.title;
const pageDescription = description ?? data.description;
const assetBase = '/shared-assets/2014';
const homeHref = canonicalHref(data.year) ?? `/${data.year}/`;
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  htmlClass="no-js"
  bodyClass={bodyClass}
  year={data.year}
  knownGaps={data.knownGaps}
  currentHref={currentHref}
>
  <Fragment slot="head">
    <link rel="stylesheet" href={`${assetBase}/video/css/fpsfMusicVid.css`} type="text/css" media="screen" />
    <link rel="stylesheet" href={`${assetBase}/assets/css/reset.css`} />
    <link rel="stylesheet" href={`${assetBase}/assets/css/ie.css`} />
    <link rel="stylesheet" href={`${assetBase}/assets/css/normalize.css`} />
    <link rel="stylesheet" href={`${assetBase}/assets/css/main.css`} />
    <link rel="stylesheet" href={`${assetBase}/assets/webfonts/ss-social.css`} />
    <link rel="stylesheet" href={`${assetBase}/assets/webfonts/ss-standard.css`} />
    <link rel="stylesheet" href={`${assetBase}/assets/webfonts/ss-symbolicons-line.css`} />
    <script src={`${assetBase}/assets/js/modernizr.js`} is:inline></script>
  </Fragment>

  <div id="container">
    <header>
      <div class="header_slide">
        <div id="header">
          <div id="ratio">
            <div class="page_hed">
              <h1><span class="escape">{data.header.title}</span></h1>
              <p class="escape">{data.header.byline}</p>
              {data.header.image && (
                <img src={`${assetBase}/${data.header.image}`} alt={data.header.title ?? data.edition} />
              )}
            </div>
          </div>
        </div>

        <div id="navigation">
          <ul class="nav main">
            {data.nav.map((item) => (
              <li class={item.className}>
                <a href={item.href} title={`Visit ${item.label}`}>{item.label}</a>
                {item.subnav && item.subnav.length > 0 && (
                  <>
                    <a class="nav_toggle" title="There's more menu under here.">
                      <i class="ss-navigatedown"></i>
                    </a>
                    <ul class="subnav">
                      {item.subnav.map((sub) => (
                        <li><a href={sub.href}>{sub.label}</a></li>
                      ))}
                    </ul>
                  </>
                )}
              </li>
            ))}
          </ul>

          {data.secondaryNav && data.secondaryNav.length > 0 && (
            <ul class="nav secondary">
              {data.secondaryNav.map((item) => (
                <li>
                  <a class={item.className} href={item.href} title={item.label}>{item.label}</a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>

      <a class="home" href={homeHref} title="Return to home"></a>
    </header>

    <slot />

    <section id="sponsor_runner">
      <div class="content">
        <div class="hed_minor">
          <h3 class="roman">Sponsors</h3>
        </div>
        <ul class="sponsor_premier group" style="border-bottom:1px solid #f6f5f1">
          {data.sponsors.map((sponsor) => (
            <li>
              <a href={sponsor.href} target="_blank" rel="noopener noreferrer">
                {sponsor.image
                  ? <img
                      src={`${assetBase}/${sponsor.image}`}
                      alt={sponsor.name}
                      onerror="this.outerHTML=`<span class='sponsor-fallback'>${this.alt}</span>`"
                    />
                  : <span class="sponsor-fallback">{sponsor.name}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <footer>
      <div class="footer_slide">
        {data.footerMap?.map((column) => (
          <div class="map_main">
            <h4><a class={column.className} href={column.href}>{column.heading}</a></h4>
            <ul>
              {column.items.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        ))}

        <div id="signup" class="map_second">
          <h4><a class="social">Keep in touch</a></h4>
          <div class="social_services group">
            <ul>
              {data.social.map((link) => (
                <li>
                  <a
                    class={`ss-icon ss-social-circle ${link.className}`}
                    title={link.title}
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>

            {/* Newsletter signup. The original posted to ymlp.com
                (long dead), so this is an archival stub: JS intercepts the
                submit and shows a friendly message instead of a broken POST. */}
            <div id="signup" class="go_signup">
              <div>Sign up for our newsletters</div>
              <form class="newsletter_stub" method="post" action="#" novalidate>
                <fieldset class="subscribe">
                  <div id="newsletter_go" class="info_group">
                    <input
                      class="email_add"
                      type="email"
                      name="YMP0"
                      size="20"
                      placeholder="you@example.com"
                      aria-label="Email address"
                      style="background-color:#646464"
                    />
                  </div>
                  <div class="info_group">
                    <button class="form_submit" type="submit">Submit</button>
                  </div>
                </fieldset>
                <p class="newsletter_stub_msg" role="status" hidden></p>
              </form>
            </div>
          </div>
        </div>

        {data.footerLegal && <p class="legal">{data.footerLegal}</p>}
      </div>
    </footer>
  </div>

  <script is:inline>
    (function () {
      var form = document.querySelector('form.newsletter_stub');
      if (!form) return;
      var msg = form.querySelector('.newsletter_stub_msg');
      var fieldset = form.querySelector('fieldset');
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var email = form.querySelector('input[name="YMP0"]');
        var val = email && email.value.trim();
        var ok = val && /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(val);
        if (msg) {
          msg.hidden = false;
          msg.textContent = ok
            ? 'Thanks! This is an archived copy of the FPSF 2014 site, so no email was actually sent.'
            : 'Please enter a valid email address.';
        }
        if (ok && fieldset) fieldset.style.display = 'none';
      });
    })();
  </script>

  {/* Lightweight replacement for the responsiveSlides jQuery plugin the
      original site used (it depended on jQuery from a now-dead Google CDN).
      The .rslides CSS leaves every <li> position:absolute/display:none, so
      without JS the galleries are invisible. This crossfades the slides,
      keeping the active one in normal flow so the container holds height. */}
  <script is:inline>
    (function () {
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll('ul.rslides').forEach(function (ul) {
        var slides = Array.prototype.filter.call(ul.children, function (n) { return n.tagName === 'LI'; });
        if (!slides.length) return;
        slides.forEach(function (li, i) {
          li.style.display = 'block';
          li.style.width = '100%';
          li.style.margin = '0';
          li.style.transition = 'opacity 0.6s ease-in-out';
          if (i === 0) {
            li.style.position = 'relative';
            li.style.opacity = '1';
            li.style.zIndex = '2';
          } else {
            li.style.position = 'absolute';
            li.style.top = '0';
            li.style.left = '0';
            li.style.opacity = '0';
            li.style.zIndex = '1';
          }
        });
        if (slides.length < 2 || reduce) return;
        var idx = 0;
        setInterval(function () {
          var cur = slides[idx];
          var nextIdx = (idx + 1) % slides.length;
          var nxt = slides[nextIdx];
          nxt.style.position = 'absolute';
          nxt.style.top = '0';
          nxt.style.left = '0';
          nxt.style.zIndex = '3';
          nxt.style.opacity = '1';
          cur.style.zIndex = '1';
          setTimeout(function () {
            nxt.style.position = 'relative';
            nxt.style.zIndex = '2';
            cur.style.position = 'absolute';
            cur.style.top = '0';
            cur.style.left = '0';
            cur.style.opacity = '0';
            idx = nextIdx;
          }, 650);
        }, 4500);
      });
    })();
  </script>

  {/* Nav dropdown click-toggle. The original relied on CSS :hover (desktop)
      + a jQuery .nav_toggle slideToggle (touch) — the jQuery is gone and the
      hover-only dropdown vanishes on tap/trackpad before you can pick an
      item. This makes the first click on a top-level nav item open (and keep
      open) its submenu; a second click follows the link. Click-away or
      picking a sub-item closes it. Desktop :hover still works alongside. */}
  <script is:inline>
    (function () {
      var items = Array.prototype.slice.call(
        document.querySelectorAll('#navigation .nav.main > li')
      ).filter(function (li) { return li.querySelector('ul.subnav'); });
      if (!items.length) return;

      function closeAll(except) {
        items.forEach(function (li) {
          if (li !== except) {
            li.classList.remove('open');
            var s = li.querySelector('ul.subnav');
            if (s) { s.style.display = ''; s.style.opacity = ''; }
          }
        });
      }

      items.forEach(function (li) {
        var link = li.querySelector(':scope > a');
        var sub = li.querySelector('ul.subnav');
        if (!link || !sub) return;
        link.addEventListener('click', function (e) {
          if (!li.classList.contains('open')) {
            e.preventDefault();
            closeAll(li);
            li.classList.add('open');
            sub.style.display = 'block';
            sub.style.opacity = '1';
          }
          // already open → let the click navigate to the section page
        });
      });

      document.addEventListener('click', function (e) {
        if (!e.target.closest('#navigation .nav.main')) closeAll(null);
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeAll(null);
      });
    })();
  </script>

  {/* Previous-lineups reveal (learn page). The archive kept #pastYears
      hidden (.hidePast) and a jQuery handler removed that class when any
      year link was clicked. Reproduce with vanilla JS. */}
  <script is:inline>
    (function () {
      var links = document.querySelectorAll('.prevShow');
      var past = document.getElementById('pastYears');
      if (!links.length || !past) return;
      links.forEach(function (a) {
        a.addEventListener('click', function () {
          past.classList.remove('hidePast');
          past.style.display = 'block';
        });
      });
    })();
  </script>
</BaseLayout>

<style>
  .newsletter_stub_msg {
    margin: 0.6em 0 0;
    padding: 0;
    font-size: 0.85em;
    line-height: 1.35;
    color: #f6f5f1;
  }
</style>
