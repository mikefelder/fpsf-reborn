---
import BaseLayout from '@layouts/BaseLayout.astro';
import type { Snapshot } from '@/types/snapshot';
import { canonicalHref } from '@data/show-years';

export interface Props {
  snapshot: Snapshot;
  title?: string;
  description?: string;
  bodyId?: string;
  bodyClass?: string;
  currentHref?: string;
}

const {
  snapshot,
  title,
  description,
  bodyId = 'index',
  bodyClass = 'sub index parent-id-0',
  currentHref,
} = Astro.props;

const data = snapshot;
const pageTitle = title ?? data.title;
const pageDescription = description ?? data.description;
const assetBase = '/shared-assets/2015';
const homeHref = canonicalHref(data.year) ?? `/${data.year}/`;
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  bodyClass={bodyClass}
  year={data.year}
  knownGaps={data.knownGaps}
  currentHref={currentHref}
  favicon={`${assetBase}/images/site/fav-ico.png`}
>
  <Fragment slot="head">
    <link rel="stylesheet" href={`${assetBase}/css/app.css`} />
    <style is:global>
      /* Sponsor sprite: keep width 100% so percentage background-position
         values in app.css stay accurate. Reduce visual size by using more
         block-grid columns (6 instead of 4) in the markup — each logo is
         naturally ~67% of the 4-col size without any sprite math breaking. */
      .sponsors-wrap ul li img {
        display: block;
        width: 100%;
        height: 0;
        padding-bottom: 53.76%;
        background-repeat: no-repeat;
      }

      /* Lineup block reconstructed in place of the dead GoEvent artist widget:
         real lineup-release poster (hero) with an accessible text transcription. */
      .ip-main .row {
        margin-top: 1rem;
        margin-bottom: 1.5rem;
      }
      .lineup-block {
        margin-top: 0;
        text-align: center;
      }
      .lineup-poster {
        display: inline-block;
        max-width: 520px;
        width: 100%;
        margin: 0 auto 34px;
      }
      .lineup-poster img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 2px;
        box-shadow: 0 6px 26px rgba(0, 0, 0, 0.35);
      }
      .lineup-block > .title {
        text-align: left;
        margin: 0 0 1.5rem;
        padding-bottom: 0.4rem;
      }
      /* Tiered lineup grids (festival-poster hierarchy) */
      .hl-grid {
        display: grid;
        gap: 16px;
        max-width: 1060px;
        margin: 0 auto;
      }
      .hl-grid--top {
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 18px;
      }
      .hl-grid--main {
        grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
        margin-bottom: 36px;
      }
      .hl-grid--under {
        grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
        gap: 12px;
        margin-bottom: 26px;
      }
      .hl-card {
        position: relative;
        aspect-ratio: 4 / 5;
        background: #0d0d0d;
        overflow: hidden;
      }
      .hl-grid--under .hl-card { aspect-ratio: 1 / 1; }
      .hl-grid--top .hl-card-name { font-size: 19px; }
      .hl-grid--under .hl-card-name {
        font-size: 12px;
        padding: 26px 10px 10px;
        letter-spacing: 0.02em;
      }
      .hl-card--static { cursor: default; }
      .hl-card-img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 15%;
        filter: grayscale(100%) contrast(1.05) brightness(0.94);
        transition: filter 0.4s ease, transform 0.55s ease;
      }
      /* Small square undercard cards work better centered */
      .hl-grid--under .hl-card-img { object-position: center center; }
      .hl-card:hover .hl-card-img {
        filter: grayscale(0%);
        transform: scale(1.05);
      }
      /* accent bar grows on hover as a clickable cue (links only) */
      a.hl-card::before {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 4px;
        background: #ffffff;
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform 0.35s ease;
        z-index: 2;
      }
      a.hl-card:hover::before { transform: scaleX(1); }
      .hl-card-name {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        padding: 38px 15px 15px;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.95) 12%, rgba(0, 0, 0, 0));
        color: #ffffff;
        font-family: 'flamamedium', 'Helvetica Neue', Arial, sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        font-size: 16px;
        line-height: 1.12;
      }
      .hl-card--noimg {
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .hl-card--noimg .hl-card-name {
        position: static;
        padding: 12px;
        text-align: center;
        background: none;
      }
      a.hl-card { display: block; text-decoration: none; color: inherit; }

      /* Artist detail page */
      .artist-detail { max-width: 760px; margin: 0 auto; }
      .artist-detail .artist-hero {
        background: #101010;
        margin-bottom: 1.25rem;
      }
      .artist-detail .artist-hero img {
        display: block;
        width: 100%;
        max-height: 60vh;
        object-fit: cover;
        object-position: center top;
      }
      .artist-detail h1.uppercase {
        font-family: 'flamamedium', 'Helvetica Neue', Arial, sans-serif;
        margin: 0 0 1.25rem;
        padding-bottom: 0.5rem;
        border-bottom: 5px solid #000000;
      }
      .artist-detail .artist-bio {
        font-family: 'flamabook', 'Helvetica Neue', Arial, sans-serif;
        font-size: 1.0625rem;
        line-height: 1.7;
        color: #33322e;
      }
      .artist-detail .artist-link { margin-top: 1rem; }
      .artist-detail .artist-link a {
        font-family: 'flamamedium', sans-serif;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.04em;
      }
      .artist-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        max-width: 760px;
        margin: 2.5rem auto 0;
        padding-top: 1.25rem;
        border-top: 1px solid #d8d6cc;
      }
      .artist-nav a { text-decoration: none; color: #1c1b18; }
      .artist-nav .artist-nav-dir {
        display: block;
        font-family: 'flamamedium', sans-serif;
        text-transform: uppercase;
        font-size: 0.7rem;
        letter-spacing: 0.05em;
        color: #9a978c;
      }
      .artist-nav .artist-nav-name {
        display: block;
        font-family: 'flamamedium', sans-serif;
        text-transform: uppercase;
        font-size: 0.95rem;
      }
      .artist-nav .artist-nav-next { text-align: right; }
      .artist-nav .artist-nav-all {
        font-family: 'flamamedium', sans-serif;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.04em;
        color: #9a978c;
      }
      @media only screen and (max-width: 40em) {
        .artist-nav .artist-nav-all { display: none; }
      }
      .lineup-undercard {
        column-count: 4;
        column-gap: 28px;
        max-width: 900px;
        margin: 0 auto;
        text-align: left;
        list-style: none;
        padding: 0;
      }
      .lineup-undercard li {
        font-family: 'flamacondensedbook', 'flamabook', 'Helvetica Neue', Arial, sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        font-size: 15px;
        line-height: 1.95;
        color: #55534b;
        break-inside: avoid;
      }
      .lineup-note {
        margin-top: 26px;
        font-size: 12px;
        color: #9a978c;
      }
      @media only screen and (max-width: 40em) {
        .lineup-undercard { column-count: 2; }
        .hl-grid--top { grid-template-columns: repeat(2, 1fr); gap: 10px; }
        .hl-grid--main { grid-template-columns: repeat(2, 1fr); gap: 10px; }
        .hl-grid--under { grid-template-columns: repeat(3, 1fr); gap: 8px; }
        .hl-card-name { font-size: 13px; }
        .hl-grid--top .hl-card-name { font-size: 14px; }
        .hl-grid--under .hl-card-name { font-size: 11px; }
      }

      /* The fixed archive/known-gaps badge lives top-right (position:fixed,
         right:14px). This era's nav also anchors top-right, so shift the
         desktop nav left of the badge so the social icons aren't covered. */
      @media only screen and (min-width: 62.125rem) {
        .cd-header .cd-secondary-nav { right: 15rem; }
        /* Desktop uses .cd-secondary-nav; hide the mobile hamburger + menu. */
        .cd-primary-nav-trigger { display: none; }
        .cd-primary-nav { display: none; }
      }

      /* Mobile nav: the desktop .cd-secondary-nav is display:none below 994px,
         so port the CodyHouse hamburger (.cd-primary-nav-trigger) + full-screen
         menu (.cd-primary-nav). We don't load CodyHouse main.js, so a small
         inline script toggles .is-visible / .is-clicked. Fixed top-LEFT to
         avoid the top-right archive badge. */
      @media only screen and (max-width: 62.06rem) {
        .cd-primary-nav-trigger {
          visibility: visible;
          display: block;
          position: fixed;
          top: 10px;
          left: 10px;
          width: 48px;
          height: 48px;
          padding: 0;
          background: rgba(0, 0, 0, 0.45);
          border-radius: 4px;
          z-index: 1002;
        }
        .cd-primary-nav-trigger .cd-menu-text { display: none; }
        .cd-primary-nav-trigger .cd-menu-icon {
          left: 50%;
          right: auto;
          transform: translate(-50%, -50%);
        }
      }

      /* Lightweight reveal-modal replacement (no Foundation JS): used by the
         banner play/poster buttons and the flood-relief "view message" link. */
      .reveal-lite-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.72);
        z-index: 1004;
        display: none;
      }
      .reveal-lite-backdrop.is-open { display: block; }
      .reveal-modal.reveal-open {
        display: block !important;
        visibility: visible !important;
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        max-height: 86vh;
        overflow: auto;
        z-index: 1005;
        opacity: 1;
      }
      /* Cosmetic dark treatment only for the video/poster modals; the
         flood-relief modal keeps its own white styling from app.css. */
      .reveal-modal.reveal-lite.reveal-open {
        width: min(760px, 92vw);
        background: #101010;
        color: #f4f2e9;
        padding: 2.25rem 1.75rem 1.75rem;
        border-radius: 3px;
        box-shadow: 0 10px 50px rgba(0, 0, 0, 0.6);
      }
      .reveal-modal.reveal-open img { max-width: 100%; height: auto; }
      .reveal-modal.reveal-lite.reveal-open .close-reveal-modal {
        position: absolute;
        top: 8px;
        right: 16px;
        font-size: 28px;
        line-height: 1;
        color: #f4f2e9;
        cursor: pointer;
        text-decoration: none;
      }
    </style>
  </Fragment>

  <div class="cd-header">
    <div class="cd-logo">
      <a href={homeHref} aria-label={data.edition}>
        <svg xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 57.083 39.514" width="100%" height="100%">
          <g>
            <path id="ch-white" d="M31.498 16.487l4.878-5.585C38.059 9 39.2 7.2 39.2 4.512c0-1.683-1-2.951-3.171-2.951c-1.853 0-3.17 1-3.17 2.732v0.585h-1.781V4.244c0-2.78 2.146-4.244 5.146-4.244c3.293 0 5 1.9 5 4.6c0 3.366-2.049 5.78-4.439 8.463l-2.78 3.049v0.024h7.561v1.61H31.498V16.487z M45.619 13.048V5.097c0-3.341 2.707-5.073 5.756-5.073c3.097 0 5.6 1.7 5.6 5.073v7.902c0 3.268-2.683 5.049-5.658 5C48.302 18 45.6 16.4 45.6 13.048z M31.299 37.758h4.244V23.515l-3.927 0.659l-0.147-1.342l5.171-1.097h0.781v16.024h3.976v1.439H31.299V37.758z" />
            <path id="ch-grey" d="M1.571 0.317h10.951v1.756H3.546v5.878h7.414v1.732H3.546v8.048H1.571V0.317z M16.526 0.341h6.244c3.366 0 5.6 2 5.6 5.219c0 2.902-2.049 5.292-5.829 5.292h-4.048v6.878h-1.976V0.341z M0 35.319l1.805-0.659c0.683 2 2.4 3.1 4.8 3.098c2.293 0 4.146-1.122 4.146-3.122c0-1.854-1.146-2.61-2.683-3.098L4.78 30.6c-2.439-0.683-3.853-1.951-3.853-4.439c0-2.878 2.439-4.683 5.585-4.683c2.683 0 4.9 1 5.8 3.293l-1.707 0.7c-0.756-1.488-2.17-2.317-4.146-2.317c-1.78 0-3.61 0.902-3.61 2.853c0 1.4 0.8 2.3 2.9 2.927l3.317 0.9c2.049 0.6 3.6 1.8 3.6 4.585c0 2.975-2.463 5.049-6.171 5.049C3.341 39.5 0.8 38.1 0 35.319z" />
          </g>
        </svg>
      </a>
    </div>

    <nav>
      <ul class="cd-secondary-nav s-media">
        {data.nav.map((item) => (
          <li>
            <a href={item.href} {...item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}>
              {item.label}
            </a>
          </li>
        ))}
        {data.social && data.social.map((link) => (
          <li>
            <a href={link.href} title={link.label} {...link.href && link.href !== '#' ? { target: '_blank', rel: 'noopener noreferrer' } : {}}>
              <i class={`icon icon-${link.className}`} aria-hidden="true"></i>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="cd-primary-nav-trigger" href="#" aria-label="Toggle menu">
      <span class="cd-menu-text">Menu</span>
      <span class="cd-menu-icon" aria-hidden="true"></span>
    </a>
  </div>

  <nav>
    <ul class="cd-primary-nav">
      {data.nav.map((item) => (
        <li class={currentHref && item.href === currentHref ? 'active' : undefined}>
          <a href={item.href} title={item.label} {...item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <section>
    <div class="hm-caption-wrap row">
      <div class="banner">
        <div class="banner-overlay video-overlay gradient-bg"></div>

        <div class="large-6 caption-l columns">
          <a href="#" data-reveal-id="videoModal" class="play-btn" title={data.banner.videoTitle}>
            <i data-icon="r" class="icon" aria-hidden="true"></i>
          </a>
          <p class="title">
            {data.banner.title.map((line, i) => (
              <>
                {line}
                {i < data.banner.title.length - 1 && <br />}
              </>
            ))}
          </p>
        </div>

        <div class="large-6 caption-r columns">
          <a href="#" data-reveal-id="imgModal" class="poster-btn right" title="View FPSF 2015 poster">
            <img src={`${assetBase}/${data.banner.posterThumb}`} alt="FPSF 2015 poster" />
          </a>
          <div class="button-wrap">
            <a
              href={data.banner.passesUrl}
              class="button secondary large"
              target="_blank"
              rel="noopener noreferrer"
            >{data.banner.passesLabel}</a><i class="icon icon-2015" aria-hidden="true"></i>
          </div>
        </div>
      </div>
    </div>
  </section>

  <slot />

  <section>
    <div class="row sponsors-wrap ip-main">
      <div class="large-12 columns">
        <h2 class="title">Sponsors</h2>
        <ul class="small-block-grid-3 medium-block-grid-5 large-block-grid-6 text-center no-bullets">
          {data.sponsors.map((sponsor) => (
            <li>
              {sponsor.href
                ? <a href={sponsor.href} target="_blank" rel="noopener noreferrer"><img class={sponsor.className} alt={sponsor.name} src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" /></a>
                : <img class={sponsor.className} alt={sponsor.name} src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" />}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <footer>
    <div class="newsletter-wrap clearfix">
      <div class="row">
        <div class="large-5 medium-6 large-centered medium-centered columns text-center">
          <div id="signup" class="signup">
            <h4 class="uppercase">Sign up for our newsletter</h4>
            <form
              method="post"
              action={data.newsletter.actionUrl}
              target="vr_optin_popup"
            >
              <input name="email_address" placeholder="EMAIL" aria-label="Email address" /><br />
              <button type="submit" class="button secondary form_submit uppercase">Submit</button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <div class="bm-footer clearfix">
      <div class="row">
        <div class="large-8 medium-8 columns">
          <div class="row">
            <div class="large-8 columns">
              <ul class="ft-nav inline-list">
                <li><a href="mailto:vendors@fpsf.com?Subject=Vendors" target="_top">vendors</a></li>
                <li><a href="mailto:media@fpsf.com?Subject=Media" target="_top">media</a></li>
                <li><a href="mailto:sponsors@fpsf.com?Subject=Sponsors" target="_top">sponsors</a></li>
                <li><a href="mailto:info@fpsf.com?Subject=General Information" target="_top">general info</a></li>
                <li><a href="https://fpsf.frontgatetickets.com/label/contact" target="_blank" rel="noopener noreferrer">ticketing FAQs</a></li>
              </ul>
              <p class="copyright">Site contents copyright &copy; 2015 FPSF 2015. All rights reserved. Sponsor logos, signage, and names may be trademarked. These materials may not be reproduced elsewhere, except by their respective copyright and trademark holders.</p>
            </div>
          </div>
        </div>

        <div class="large-4 medium-4 columns tw-wrap">
          <p class="title uppercase">Live Feed</p>
          <div class="tw-feed">
            <p class="status">Peep the 2015 <a href="https://twitter.com/search?q=%23FPSF" target="_blank" rel="noopener noreferrer">#FPSF</a> Video re-cap now at <a href="https://t.co/DCWpxJK1PI" target="_blank" rel="noopener noreferrer">http://t.co/DCWpxJK1PI</a></p>
            <p class="info">1 day, 23 hours ago<br /><a href="https://twitter.com/fpsf" target="_blank" rel="noopener noreferrer" class="uppercase">Details</a></p>
          </div>
          <p class="credits">website by: <a href="https://www.baalspots.com/" target="_blank" rel="noopener noreferrer">Baal &amp; Spots</a></p>
        </div>
      </div>
    </div>
  </footer>

  <div id="videoModal" class="reveal-modal reveal-lite" hidden>
    <div class="flex-video widescreen">
      <iframe data-src={data.banner.videoUrl} frameborder="0" allowfullscreen title={data.banner.videoTitle}></iframe>
    </div>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
  </div>

  <div id="imgModal" class="reveal-modal reveal-lite" hidden>
    <div class="text-center">
      <img src={`${assetBase}/${data.banner.posterFull}`} alt="FPSF 2015 lineup-release poster" />
      <br />
      <a href={`${assetBase}/${data.banner.posterFull}`} target="_blank" rel="noopener noreferrer" class="button secondary large">Open full poster</a>
    </div>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
  </div>

  <script is:inline>
    (function () {
      var backdrop;
      function openModal(id) {
        var m = document.getElementById(id);
        if (!m) return;
        var f = m.querySelector('iframe[data-src]');
        if (f && !f.getAttribute('src')) f.setAttribute('src', f.getAttribute('data-src'));
        if (!backdrop) {
          backdrop = document.createElement('div');
          backdrop.className = 'reveal-lite-backdrop';
          backdrop.addEventListener('click', closeModals);
          document.body.appendChild(backdrop);
        }
        backdrop.classList.add('is-open');
        m.hidden = false;
        m.classList.add('reveal-open');
        document.body.style.overflow = 'hidden';
      }
      function closeModals() {
        document.querySelectorAll('.reveal-lite.reveal-open').forEach(function (m) {
          m.classList.remove('reveal-open');
          m.hidden = true;
          var f = m.querySelector('iframe[data-src]');
          if (f) f.removeAttribute('src');
        });
        if (backdrop) backdrop.classList.remove('is-open');
        document.body.style.overflow = '';
      }
      document.addEventListener('click', function (e) {
        var opener = e.target.closest('[data-reveal-id]');
        if (opener) { e.preventDefault(); openModal(opener.getAttribute('data-reveal-id')); return; }
        if (e.target.closest('.close-reveal-modal')) { e.preventDefault(); closeModals(); }
      });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModals(); });
    })();
  </script>

  <script is:inline>
    (function () {
      var trigger = document.querySelector('.cd-primary-nav-trigger');
      var nav = document.querySelector('.cd-primary-nav');
      var header = document.querySelector('.cd-header');
      if (!trigger || !nav) return;
      var icon = trigger.querySelector('.cd-menu-icon');
      function close() {
        nav.classList.remove('is-visible');
        if (icon) icon.classList.remove('is-clicked');
        if (header) header.classList.remove('menu-is-open');
      }
      trigger.addEventListener('click', function (e) {
        e.preventDefault();
        nav.classList.toggle('is-visible');
        if (icon) icon.classList.toggle('is-clicked');
        if (header) header.classList.toggle('menu-is-open');
      });
      nav.addEventListener('click', function (e) { if (e.target.closest('a')) close(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
    })();
  </script>

  <script is:inline>
    (function () {
      // Foundation tabs (e.g. Learn page "previous lineups") need JS to switch
      // panels; we don't load Foundation, so re-implement the .active toggle.
      document.querySelectorAll('.tabs[data-tab]').forEach(function (tabs) {
        tabs.addEventListener('click', function (e) {
          var link = e.target.closest('.tab-title a');
          if (!link) return;
          var target = document.querySelector(link.getAttribute('href'));
          if (!target) return;
          e.preventDefault();
          tabs.querySelectorAll('.tab-title').forEach(function (t) {
            t.classList.remove('active');
            var a = t.querySelector('a');
            if (a) a.setAttribute('aria-selected', 'false');
          });
          var li = link.closest('.tab-title');
          li.classList.add('active');
          link.setAttribute('aria-selected', 'true');
          var content = target.parentElement;
          content.querySelectorAll('.content').forEach(function (p) {
            p.classList.remove('active');
            p.setAttribute('aria-hidden', 'true');
          });
          target.classList.add('active');
          target.setAttribute('aria-hidden', 'false');
        });
      });
    })();
  </script>
</BaseLayout>

