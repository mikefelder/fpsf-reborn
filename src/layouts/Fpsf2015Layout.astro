---
import BaseLayout from '@layouts/BaseLayout.astro';
import type { Snapshot } from '@/types/snapshot';
import { canonicalHref } from '@data/show-years';

export interface Props {
  snapshot: Snapshot;
  title?: string;
  description?: string;
  bodyId?: string;
  bodyClass?: string;
  currentHref?: string;
}

const {
  snapshot,
  title,
  description,
  bodyId = 'index',
  bodyClass = 'sub index parent-id-0',
  currentHref,
} = Astro.props;

const data = snapshot;
const pageTitle = title ?? data.title;
const pageDescription = description ?? data.description;
const assetBase = '/shared-assets/2015';
const homeHref = canonicalHref(data.year) ?? `/${data.year}/`;
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  bodyClass={bodyClass}
  year={data.year}
  knownGaps={data.knownGaps}
  currentHref={currentHref}
>
  <Fragment slot="head">
    <link rel="stylesheet" href={`${assetBase}/css/app.css`} />
    <style>
      /* Foundation-era visual fallbacks for 2015 — kicks in when app.css
         doesn't fully load or when sponsor images are missing. */
      body { background: #111; color: #f0eee5; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; }
      .ip-container, .cd-header, section, footer { display: block; }
      .cd-logo svg path#ch-white { fill: #fff; }
      .cd-logo svg path#ch-grey { fill: #999; }
      .cd-header {
        position: relative;
        padding: 14px 24px;
        display: flex;
        align-items: center;
        gap: 24px;
        background: rgba(0,0,0,0.6);
      }
      .cd-header .cd-logo { width: 80px; height: 56px; flex-shrink: 0; }
      .cd-header nav { flex: 1; }
      .cd-secondary-nav { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 16px; justify-content: flex-end; }
      .cd-secondary-nav li a { color: #f0eee5; text-decoration: none; font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; }
      .cd-secondary-nav li a:hover { color: #f7c948; }
      .banner {
        position: relative;
        min-height: 460px;
        background: linear-gradient(135deg, #2d004d 0%, #6b1d6e 50%, #c64f3c 100%);
        padding: 60px 24px;
      }
      .banner-overlay { display: none; }
      .hm-caption-wrap { display: flex; flex-wrap: wrap; gap: 24px; max-width: 1200px; margin: 0 auto; align-items: center; }
      .caption-l, .caption-r { flex: 1 1 360px; padding: 12px; }
      .caption-l .title { font-size: 3.6em; font-weight: 700; letter-spacing: -0.02em; line-height: 0.95; color: #fff; margin: 0; }
      .play-btn { display: inline-block; padding: 10px 18px; background: rgba(0,0,0,0.6); color: #fff; border-radius: 999px; margin-bottom: 14px; text-decoration: none; }
      .caption-r .poster-btn img { max-width: 280px; box-shadow: 0 6px 24px rgba(0,0,0,0.4); border: 4px solid rgba(255,255,255,0.1); }
      .button-wrap { margin-top: 18px; }
      .button-wrap a.button { display: inline-block; padding: 12px 22px; background: #f7c948; color: #111; text-decoration: none; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; border-radius: 4px; }
      .event-date { padding: 32px 24px; background: #1a1a1a; }
      .event-date h1 { font-size: 1.6em; margin: 0; color: #fff; letter-spacing: 0.04em; }
      .event-date h1 small { color: #b6b3a3; font-size: 0.7em; display: block; margin-top: 4px; }
      .ip-main { padding: 32px 24px; max-width: 1200px; margin: 0 auto; }
      .flex-video iframe { width: 100%; aspect-ratio: 16 / 9; border: 0; }
      .goevent-web { padding: 24px; background: rgba(255,255,255,0.05); text-align: center; color: #888; font-size: 14px; }
      .sponsors-wrap { padding: 32px 24px; background: #f0eee5; color: #111; }
      .sponsors-wrap .title { font-size: 1.8em; margin: 0 0 18px; letter-spacing: 0.04em; text-transform: uppercase; }
      .sponsors-wrap ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 18px; }
      .sponsors-wrap li { padding: 18px 12px; background: #fff; border: 1px solid #e2dfd5; text-align: center; min-height: 80px; display: flex; align-items: center; justify-content: center; font-size: 13px; color: #555; }
      .sponsors-wrap li a { color: #115; text-decoration: none; font-weight: 600; }
      .newsletter-wrap { padding: 40px 24px; background: #111; text-align: center; color: #f0eee5; }
      .newsletter-wrap h4 { letter-spacing: 0.1em; margin: 0 0 14px; }
      .newsletter-wrap input[type="text"], .newsletter-wrap input[type="email"] {
        padding: 10px 12px; border: 1px solid #555; background: #222; color: #f0eee5; width: 280px; max-width: 100%;
      }
      .newsletter-wrap button { padding: 10px 18px; background: #f7c948; color: #111; border: 0; font-weight: 700; margin-left: 6px; cursor: pointer; }
    </style>
  </Fragment>

  <div class="cd-header">
    <div class="cd-logo">
      <a href={homeHref} aria-label={data.edition}>
        <svg xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 57.083 39.514" width="100%" height="100%">
          <g>
            <path id="ch-white" d="M31.498 16.487l4.878-5.585C38.059 9 39.2 7.2 39.2 4.512c0-1.683-1-2.951-3.171-2.951c-1.853 0-3.17 1-3.17 2.732v0.585h-1.781V4.244c0-2.78 2.146-4.244 5.146-4.244c3.293 0 5 1.9 5 4.6c0 3.366-2.049 5.78-4.439 8.463l-2.78 3.049v0.024h7.561v1.61H31.498V16.487z M45.619 13.048V5.097c0-3.341 2.707-5.073 5.756-5.073c3.097 0 5.6 1.7 5.6 5.073v7.902c0 3.268-2.683 5.049-5.658 5C48.302 18 45.6 16.4 45.6 13.048z M31.299 37.758h4.244V23.515l-3.927 0.659l-0.147-1.342l5.171-1.097h0.781v16.024h3.976v1.439H31.299V37.758z" />
            <path id="ch-grey" d="M1.571 0.317h10.951v1.756H3.546v5.878h7.414v1.732H3.546v8.048H1.571V0.317z M16.526 0.341h6.244c3.366 0 5.6 2 5.6 5.219c0 2.902-2.049 5.292-5.829 5.292h-4.048v6.878h-1.976V0.341z M0 35.319l1.805-0.659c0.683 2 2.4 3.1 4.8 3.098c2.293 0 4.146-1.122 4.146-3.122c0-1.854-1.146-2.61-2.683-3.098L4.78 30.6c-2.439-0.683-3.853-1.951-3.853-4.439c0-2.878 2.439-4.683 5.585-4.683c2.683 0 4.9 1 5.8 3.293l-1.707 0.7c-0.756-1.488-2.17-2.317-4.146-2.317c-1.78 0-3.61 0.902-3.61 2.853c0 1.4 0.8 2.3 2.9 2.927l3.317 0.9c2.049 0.6 3.6 1.8 3.6 4.585c0 2.975-2.463 5.049-6.171 5.049C3.341 39.5 0.8 38.1 0 35.319z" />
          </g>
        </svg>
      </a>
    </div>

    <nav>
      <ul class="cd-secondary-nav s-media">
        {data.nav.map((item) => (
          <li>
            <a href={item.href} {...item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}>
              {item.label}
            </a>
          </li>
        ))}
        {data.social && data.social.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer" title={link.label}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <slot />
</BaseLayout>
