---
import '@styles/fpsf-2011-main.css';
import Fpsf2011Layout from '@layouts/Fpsf2011Layout.astro';
import snapshot from '@data/snapshot-2011-main.json';

const assetBase = '/shared-assets/2011/images';
---
<Fpsf2011Layout
  snapshot={snapshot}
  title={snapshot.title}
  bodyClass="state-main"
  currentHref="/2011/"
>
  <div class="colmask threecol">
    <div class="colmid">
      <div class="colleft">
        <div class="col1">
          <div style="padding:0 14px">
            <div id="fade_frame">
              <div id="fadeshow1" aria-label="FPSF 2011 hero slideshow placeholder"></div>
            </div>

            <div class="fontface_K" style="padding-top:20px">
              <div style="color:#000000;font-size:2.4em;line-height:1.1;letter-spacing:-1px">
                {snapshot.intro.headline}
              </div>
              <div style="color:#999;font-size:1.8em;line-height:1.2">
                {snapshot.intro.subhead}
              </div>
              <div style="color:#333;font-size:1.2em">
                {snapshot.intro.tagline}
              </div>
            </div>

            <div id="break_small"></div>

            {snapshot.intro.paragraphs.map((paragraph) => (
              <p class="hero-callout">{paragraph}</p>
            ))}

            <div class="high-roller">
              <a href={snapshot.ctas.highRollerUrl} target="_blank" rel="noopener noreferrer">
                <p>{snapshot.ctas.highRollerCopy}</p>
              </a>
              <a href={snapshot.ctas.cabanaHref}>
                <img
                  src={`${assetBase}/${snapshot.ctas.cabanaImage}`}
                  alt="Cabana pass detail"
                  style="width:100%; max-width:400px; border:0"
                  onerror="this.style.display='none'"
                />
              </a>
            </div>
          </div>
        </div>

        <div class="col2" style="text-align:center">
          <a id="side_local" href={snapshot.headliner.lineupHref} title="Line Up">
            <font size="+3">{snapshot.headliner.name}</font>
          </a>
          <div id="local_text">
            <a href={snapshot.headliner.lineupHref}>{snapshot.headliner.tagline}</a>
          </div>

          <div id="break"></div>

          <a href={snapshot.ctas.passUrl}>
            <img
              src={`${assetBase}/${snapshot.ctas.passImage}`}
              alt="Get a pass"
              style="width:100%; border:0"
            />
          </a>

          <div id="break"></div>

          <a href={snapshot.ctas.hotelUrl} target="_blank" rel="noopener noreferrer">
            <img
              src={`${assetBase}/${snapshot.ctas.hotelImage}`}
              alt="Hotel booking via Passkey"
              style="width:100%; border:0"
            />
          </a>
        </div>

        <div class="col3">
          <a href={snapshot.ctas.shirtUrl} target="_blank" rel="noopener noreferrer">
            <img
              src={`${assetBase}/${snapshot.ctas.shirtImage}`}
              alt="FPSF merch"
              style="width:100%; border:0"
            />
          </a>

          <div id="break"></div>

          <div class="news-label">
            <a href={snapshot.tumblr.blogUrl} target="_blank" rel="noopener noreferrer">NEWS</a>
          </div>
          <div class="news-source">From Tumblr Feed</div>
          <p style="font-size:1.1em">
            Visit the <a href={snapshot.tumblr.blogUrl} target="_blank" rel="noopener noreferrer">FPSF Tumblr</a> for archived news posts.
          </p>
        </div>
      </div>
    </div>

    <div id="footer1" class="fontface_K">
      <div id="box" style="margin:0 10px; width:100%">
        <div id="box" style="background:url('/shared-assets/2011/images/greybg.png') repeat; margin:0 auto; width:920px; padding-left:0px">
          <div id="stripe" style="margin-bottom:10px"></div>

          {/* Column 1: Vimeo recap. Original site embedded
              https://player.vimeo.com/video/20397258 in an iframe, but the
              video (FREE PRESS SUMMERFEST 2011 LINE-UP by Free Video Houston)
              is now privacy-restricted and the player URL returns HTTP 401
              off vimeo.com. Fall back to a clickable poster linking out. */}
          <div id="box" style="margin:0; padding-left:10px">
            <a
              href={snapshot.vimeo.pageUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="vimeo-poster"
              aria-label={`Watch on Vimeo: ${snapshot.vimeo.title}`}
              style="display:block; width:400px; height:310px; position:relative; overflow:hidden; background:#000"
            >
              <img
                src={`${assetBase}/${snapshot.vimeo.posterImage}`}
                alt={snapshot.vimeo.title}
                width="400"
                height="310"
                style="display:block; width:100%; height:100%; object-fit:cover; border:0"
              />
              <span class="vimeo-poster__play" aria-hidden="true">▶</span>
              <span class="vimeo-poster__caption">
                <span class="vimeo-poster__title">{snapshot.vimeo.title}</span>
                <span class="vimeo-poster__duration">{snapshot.vimeo.duration}</span>
              </span>
            </a>
          </div>

          {/* Column 2: Facebook fan-box slot (original used FB likebox widget,
              deprecated; render a static FB link inside the same green panel). */}
          <div id="box" class="fb-fan-box" style="padding:10px; padding-bottom:5px; background-color:#a1cdb2; margin:0; margin-left:10px; height:295px; width:200px">
            <a
              href={snapshot.social.find((link) => link.label === 'Facebook')?.href}
              target="_blank"
              rel="noopener noreferrer"
              class="fb-fan-link"
            >
              <div class="fb-fan-title">Free Press Summer Fest</div>
              <div class="fb-fan-sub">on Facebook</div>
              <div class="fb-fan-cta">Like</div>
            </a>
          </div>

          {/* Column 3: Newsletter subscribe form */}
          <div id="box" style="margin:0; margin-left:10px">
            <div id="subscribe_box">
              <div id="subscribe" class="fontface_klav_b">
                <div style="letter-spacing:1px; padding-left:5px; font-size:.9em">SIGN UP FOR THE LATEST FEST INFO</div>
                <div style="padding-left:10px; font-size:.75em">*Required</div>

                <form
                  method="post"
                  action={snapshot.subscribe.actionUrl}
                  target="_blank"
                  style="margin-top:8px"
                >
                  <table border="0" align="left" cellspacing="0" cellpadding="4">
                    {snapshot.subscribe.fields.map((field) => (
                      <tr>
                        <td style="vertical-align:top; font-size:.85em; letter-spacing:1px">
                          {field.label}:
                        </td>
                        <td style="vertical-align:top">
                          <input type="text" name={field.name} size="18" required={field.required} />
                        </td>
                      </tr>
                    ))}
                    <tr>
                      <td colspan="2" style="padding-top:6px">
                        <input
                          type="image"
                          src={`${assetBase}/${snapshot.subscribe.submitImage}`}
                          alt="Subscribe"
                        />
                      </td>
                    </tr>
                  </table>
                </form>
              </div>
            </div>
          </div>

          {/* Column 4: Twitter feed (original used feed.php iframe, gone).
              Wraps to a second row below the subscribe box, matching the
              archive's margin-top:10px on this element. */}
          <div id="box" style="margin:0; margin-top:10px; margin-left:10px">
            <div id="twitter_box">
              <div class="fontface_klav_b" style="font-size:18px; color:#000; padding:5px; margin-left:8px">FROM TWITTER</div>
              <p style="padding:8px 12px; font-size:1.1em; line-height:1.4; margin:0">
                <a
                  href={snapshot.social.find((link) => link.label === 'Twitter')?.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  style="color:#000"
                >@fpsummerfest</a>
              </p>
            </div>
          </div>

          <div id="stripe" style="margin-top:10px"></div>
        </div>
      </div>
    </div>

    <div id="footer2">
      <div id="box" style="width:100%; padding:0 10px 10px 0; margin-top:0">
        <div class="footerboxleft">
          <a href={snapshot.sponsorBarHref}>
            <img
              src={`${assetBase}/${snapshot.sponsorBarImage}`}
              alt="FPSF 2011 sponsors"
              height="118"
              style="display:block; border:0"
            />
          </a>
        </div>
        <div class="footerboxright">
          <img
            src={`${assetBase}/${snapshot.socialBarImage}`}
            alt="FPSF 2011 social links (FPH / Pegstar / Facebook / Twitter / YouTube / Vimeo)"
            height="118"
            style="display:block; border:0"
            usemap="#socialbar-map"
          />
          <map name="socialbar-map" id="socialbar-map">
            {snapshot.socialBarMap.map((area) => (
              <area
                shape={area.shape}
                coords={area.coords}
                href={area.href}
                alt={area.alt}
                target={area.target}
                rel={area.target === '_blank' ? 'noopener noreferrer' : undefined}
              />
            ))}
          </map>
        </div>
      </div>
    </div>
  </div>
</Fpsf2011Layout>
