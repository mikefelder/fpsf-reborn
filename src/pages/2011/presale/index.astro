---
import Fpsf2011Layout from '@layouts/Fpsf2011Layout.astro';
import snapshot from '@data/snapshot-2011-presale.json';

const slideCount = snapshot.slideshow.images.length;
const slideDelayMs = snapshot.slideshow.intervalMs;
const totalDurationMs = slideDelayMs * slideCount;
---
<Fpsf2011Layout snapshot={snapshot} title={snapshot.title} currentHref="/2011/presale/">
  <div class="colmask threecol">
    <div class="colmid">
      <div class="colleft">
        <div class="col1">
          <div style="padding:0px 20px 0px 20px">
            <div id="fadeshow1" aria-label="FPSF 2011 hero slideshow">
              {snapshot.slideshow.images.map((image, index) => (
                <div
                  class="slide placeholder"
                  style={`animation-duration:${totalDurationMs}ms;animation-delay:${index * slideDelayMs}ms;background-image:url('/shared-assets/2011/images/mainslide/${image}')`}
                >
                  {image}
                </div>
              ))}
            </div>

            <div class="fontface_K" style="padding-top:20px">
              <div style="color:#000000;font-size:2.6em;line-height:1.1">
                {snapshot.intro.headline}
              </div>
              <div style="color:#999;font-size:2em;line-height:1.2">
                {snapshot.intro.subhead}
              </div>
              <div style="color:#333;font-size:1.4em">
                {snapshot.intro.tagline}
              </div>
            </div>

            <div id="break_small"></div>

            {snapshot.intro.paragraphs.map((paragraph) => (
              <p style="font-size:1.2em;line-height:1.5">{paragraph}</p>
            ))}
          </div>
        </div>

        <div class="col2" style="text-align:center">
          <a href={snapshot.ctas.passUrl} target="_blank" rel="noopener noreferrer">
            <img
              src={`/shared-assets/2011/images/${snapshot.ctas.passImage}`}
              alt="Get a blind pass"
              style="width:100%"
            />
          </a>
          <div id="break"></div>

          <a href={snapshot.ctas.sonicbidsUrl} target="_blank" rel="noopener noreferrer">
            <img
              src={`/shared-assets/2011/images/${snapshot.ctas.sonicbidsImage}`}
              alt="Sonicbids — local band submissions"
              style="width:70%"
            />
          </a>
          <div id="break"></div>

          <div style="color:#333;font-size:2em" class="fontface_K">
            {snapshot.ctas.lineupTeaser}
          </div>
        </div>

        <div class="col3">
          <a href={snapshot.ctas.passUrl} target="_blank" rel="noopener noreferrer">
            <img
              src={`/shared-assets/2011/images/${snapshot.ctas.passRightImage}`}
              alt="Get a pass"
              style="width:100%"
            />
          </a>
          <div id="break"></div>
          <img
            src={`/shared-assets/2011/images/${snapshot.ctas.photographerCredit}`}
            alt="Photographer credit"
            style="width:100%"
          />
        </div>
      </div>
    </div>

    <div id="footer1" class="fontface_K">
      <div id="box" style="margin:0 10px; width:100%">
        <div id="box" style="background:url('/shared-assets/2011/images/greybg.png') repeat; margin:0 auto; width:920px; padding-left:0px">
          <div id="stripe" style="margin-bottom:10px"></div>

          {/* Column 1: Vimeo recap (FPSF 2010 recap on the presale page).
              Original iframe still works for some ids but many Vimeo videos
              now block cross-domain embedding, so this may render blank.
              TODO: replace with local MP4 rip if the iframe stops working. */}
          <div id="box" style="margin:0; padding-left:10px">
            <iframe
              src={`https://player.vimeo.com/video/${snapshot.vimeo.id}?title=0&byline=0&portrait=0`}
              width="400"
              height="310"
              frameborder="0"
              allow="autoplay; fullscreen"
              title={snapshot.vimeo.title}
            ></iframe>
          </div>

          {/* Column 2: Facebook fan-box slot. Presale used a YELLOW (#FF0)
              background where main used green (#a1cdb2). Widget is dead;
              render a static Like-style card so the visual mass matches. */}
          <div id="box" class="fb-fan-box fb-fan-box--presale" style="padding:10px; padding-bottom:5px; background-color:#FF0; margin:0; margin-left:10px; height:295px; width:200px">
            <a
              href={snapshot.social.find((link) => link.label === 'Facebook')?.href}
              target="_blank"
              rel="noopener noreferrer"
              class="fb-fan-link"
            >
              <div class="fb-fan-title">Free Press Summer Fest</div>
              <div class="fb-fan-sub">on Facebook</div>
              <div class="fb-fan-cta">Like</div>
            </a>
          </div>

          {/* Column 3: Twitter box. Archive presale order was
              vimeo → FB → twitter → subscribe (twitter above subscribe),
              which differs from the main-state order. */}
          <div id="box" style="margin:0; margin-left:10px">
            <div id="twitter_box">
              <div class="fontface_klav_b" style="font-size:18px; color:#000; padding:5px; margin-left:8px">FROM TWITTER</div>
              <p style="padding:8px 12px; font-size:1.1em; line-height:1.4; margin:0">
                <a
                  href={snapshot.social.find((link) => link.label === 'Twitter')?.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  style="color:#000"
                >@fpsummerfest</a>
              </p>
            </div>
          </div>

          {/* Column 4: Newsletter subscribe form (teal on presale). Wraps
              to a second row via margin-top:10px, matching the archive. */}
          <div id="box" style="margin:0; margin-top:10px; margin-left:10px">
            <div id="subscribe_box">
              <div id="subscribe" class="fontface_klav_b">
                <div style="letter-spacing:1px; padding-left:5px; font-size:.9em">SIGN UP FOR THE LATEST FEST INFO</div>
                <div style="padding-left:10px; font-size:.75em">*Required</div>

                <form
                  method="post"
                  action={snapshot.subscribe.actionUrl}
                  target="_blank"
                  style="margin-top:8px"
                >
                  <table border="0" align="left" cellspacing="0" cellpadding="4">
                    {snapshot.subscribe.fields.map((field) => (
                      <tr>
                        <td style="vertical-align:top; font-size:.85em; letter-spacing:1px">
                          {field.label}:
                        </td>
                        <td style="vertical-align:top">
                          <input
                            type="text"
                            name={field.name}
                            size="18"
                            required={field.required}
                          />
                        </td>
                      </tr>
                    ))}
                    <tr>
                      <td colspan="2" style="padding-top:6px">
                        <input
                          type="image"
                          src={`/shared-assets/2011/images/${snapshot.subscribe.submitImage}`}
                          alt="Subscribe"
                        />
                      </td>
                    </tr>
                  </table>
                </form>
              </div>
            </div>
          </div>

          <div id="stripe" style="margin-top:10px"></div>
        </div>
      </div>
    </div>

    <div id="footer2">
      <div id="box" style="width:100%; padding:0 10px 10px 0; margin-top:0">
        <div class="footerboxleft">
          <a href={snapshot.sponsorBarHref}>
            <img
              src={`/shared-assets/2011/images/${snapshot.sponsorBarImage}`}
              alt="FPSF 2011 sponsors"
              height="118"
              style="display:block; border:0"
            />
          </a>
        </div>
        <div class="footerboxright">
          <img
            src={`/shared-assets/2011/images/${snapshot.socialBarImage}`}
            alt="FPSF 2011 social links (FPH / Pegstar / Facebook / Twitter / YouTube / Vimeo)"
            height="118"
            style="display:block; border:0"
            usemap="#socialbar-map"
          />
          <map name="socialbar-map" id="socialbar-map">
            {snapshot.socialBarMap.map((area) => (
              <area
                shape={area.shape}
                coords={area.coords}
                href={area.href}
                alt={area.alt}
                target={area.target}
                rel={area.target === '_blank' ? 'noopener noreferrer' : undefined}
              />
            ))}
          </map>
        </div>
      </div>
    </div>
  </div>
</Fpsf2011Layout>
