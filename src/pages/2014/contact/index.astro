---
import Fpsf2014Layout from '@layouts/Fpsf2014Layout.astro';
import snapshot from '@data/snapshot-2014-main.json';
import pageHtml from '@data/pages/2014/contact.html?raw';

const pageTitle = `Contact | ${snapshot.title}`;
---
<Fpsf2014Layout
  snapshot={snapshot}
  title={pageTitle}
  bodyClass="contact"
  currentHref="/2014/contact/"
>
  <Fragment set:html={pageHtml} />
</Fpsf2014Layout>
