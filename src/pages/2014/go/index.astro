---
import Fpsf2014Layout from '@layouts/Fpsf2014Layout.astro';
import snapshot from '@data/snapshot-2014-main.json';
import pageHtml from '@data/pages/2014/go.html?raw';

const pageTitle = `Go | ${snapshot.title}`;
---
<Fpsf2014Layout
  snapshot={snapshot}
  title={pageTitle}
  bodyClass="go"
  currentHref="/2014/go/"
>
  <Fragment set:html={pageHtml} />
</Fpsf2014Layout>
