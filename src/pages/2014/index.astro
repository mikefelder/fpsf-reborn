---
import Fpsf2014Layout from '@layouts/Fpsf2014Layout.astro';
import snapshot from '@data/snapshot-2014-main.json';

const assetBase = '/shared-assets/2014';
---
<Fpsf2014Layout snapshot={snapshot} currentHref="/2014/">
  <div class="content group">
    {snapshot.contentBanners?.map((banner) => {
      const external = banner.href.startsWith('http');
      return (
        <a
          href={banner.href}
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener noreferrer' : undefined}
        >
          <img src={`${assetBase}/${banner.image}`} width="100%" alt={banner.alt} />
        </a>
      );
    })}

    <section id="video_prime">
      <div class="video">
        <div class="video_hed"></div>
        <a
          href={snapshot.hero.videoUrl}
          rel="fpsfMusicVid"
          title={snapshot.hero.videoTitle}
          class="play"
        >
          <i class="ss-icon ss-symbolicons-line">Play</i>
        </a>
        <img
          src={`${assetBase}/${snapshot.hero.image}`}
          width="100%"
          alt={snapshot.hero.videoTitle}
        />
      </div>
    </section>

    <section id="passes" class="group">
      <div class="hed_major">
        <h3>Get passes</h3>
      </div>
      <div class="chunk group passes">
        {snapshot.passes.map((tier) => (
          <div class="subchunk">
            <div class="sub_hed pass_level">
              <h3>{tier.name}</h3>
              <p class="pricing presale">
                <span class="pass_now">{tier.price}<span class="price_terms"> {tier.priceTerms}</span></span>
              </p>
            </div>
            <div class="detail">
              <ul class="punchlist">
                {tier.details.map((detail) => <li>{detail}</li>)}
              </ul>
              <a class="pass_button" href={tier.buyHref} title={tier.buyTitle} target="_blank" rel="noopener noreferrer">
                Buy now
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section id="video_home">
      <div class="hed_major">
        <h3>#FPSF now</h3>
        <div class="previous">
          <div class="social_services group">
            <ul>
              {snapshot.social.map((link) => (
                <li>
                  <a
                    class={`ss-icon ss-social-circle ${link.className}`}
                    title={link.title}
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  </div>
</Fpsf2014Layout>
