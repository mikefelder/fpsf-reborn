---
import Fpsf2015Layout from '@layouts/Fpsf2015Layout.astro';
import snapshot from '@data/snapshot-2015-main.json';

const assetBase = '/shared-assets/2015';
---
<Fpsf2015Layout snapshot={snapshot} currentHref="/2015/">
  <section>
    <div class="hm-caption-wrap row">
      <div class="banner">
        <div class="banner-overlay video-overlay gradient-bg"></div>

        <div class="large-6 caption-l columns">
          <a
            href={snapshot.banner.videoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="play-btn"
            title={snapshot.banner.videoTitle}
          >▶ Watch lineup release</a>
          <p class="title">
            {snapshot.banner.title.map((line, i) => (
              <>
                {line}
                {i < snapshot.banner.title.length - 1 && <br />}
              </>
            ))}
          </p>
        </div>

        <div class="large-6 caption-r columns">
          <a
            href={`${assetBase}/${snapshot.banner.posterFull}`}
            class="poster-btn right"
            target="_blank"
            rel="noopener noreferrer"
            title="View FPSF 2015 poster"
          >
            <img src={`${assetBase}/${snapshot.banner.posterThumb}`} alt="FPSF 2015 poster" />
          </a>
          <div class="button-wrap">
            <a
              href={snapshot.banner.passesUrl}
              class="button secondary large"
              target="_blank"
              rel="noopener noreferrer"
            >{snapshot.banner.passesLabel}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="event-date">
      <div class="row">
        <div class="large-12 text-left columns">
          <h1>{snapshot.eventDate.headline}<br /><small>{snapshot.eventDate.city}</small></h1>
        </div>
      </div>
    </div>

    <div class="row ip-main">
      <div class="large-12 columns">
        <div class="row">
          <div class="large-10 large-centered text-center columns">
            <div class="flex-video widescreen">
              <iframe
                src={snapshot.banner.videoUrl}
                frameborder="0"
                allowfullscreen
                title={snapshot.banner.videoTitle}
              ></iframe>
            </div>
          </div>
        </div>

        <div class="row" style="margin-top:24px">
          <div class="goevent-web">
            <p>Lineup / artist list was rendered by an external GoEvent ticketing widget. The widget loader is no longer live; visit the link above for tickets.</p>
            <p style="margin-top:14px; font-size:12px; opacity:0.6">Original loader: <code>{snapshot.ticketingWidget.loaderUrl}</code></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="row sponsors-wrap ip-main">
      <div class="large-12 columns">
        <h2 class="title">Sponsors</h2>
        <ul class="small-block-grid-2 medium-block-grid-4 large-block-grid-4 text-center no-bullets">
          {snapshot.sponsors.map((sponsor) => (
            <li>
              {sponsor.href
                ? <a href={sponsor.href} target="_blank" rel="noopener noreferrer">{sponsor.name}</a>
                : <span>{sponsor.name}</span>}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <footer>
    <div class="newsletter-wrap clearfix">
      <div class="row">
        <div class="large-5 medium-6 large-centered medium-centered columns text-center">
          <div id="signup" class="signup">
            <h4 class="uppercase">Sign up for our newsletter</h4>
            <form
              method="post"
              action={snapshot.newsletter.actionUrl}
              target="vr_optin_popup"
            >
              <input type="email" name="email" placeholder="Email" required />
              <button type="submit">Sign up</button>
            </form>
          </div>

          {snapshot.appLinks && (
            <p style="margin-top:24px; font-size:14px; color:#b6b3a3">
              {snapshot.appLinks.prompt} {' '}
              <a href={snapshot.appLinks.appStoreUrl} target="_blank" rel="noopener noreferrer" style="color:#f7c948">iOS</a>
              {' · '}
              <a href={snapshot.appLinks.googlePlayUrl} target="_blank" rel="noopener noreferrer" style="color:#f7c948">Android</a>
            </p>
          )}
        </div>
      </div>
    </div>
  </footer>
</Fpsf2015Layout>
