---
import Fpsf2015Layout from '@layouts/Fpsf2015Layout.astro';
import ArtistCard2015 from '@components/ArtistCard2015.astro';
import snapshot from '@data/snapshot-2015-main.json';
---
<Fpsf2015Layout snapshot={snapshot} currentHref="/2015/">
  <section>
    <div class="event-date">
      <div class="row">
        <div class="large-12 text-left columns">
          <h1>{snapshot.eventDate.headline}<br /><small>{snapshot.eventDate.city}</small></h1>
        </div>
      </div>
    </div>

    <div class="row ip-main">
      <div class="large-12 columns">
        <div class="row">
          <div class="lineup-block">
            <h2 class="title uppercase">Lineup</h2>

            <div class="hl-grid hl-grid--top">
              {snapshot.lineup.headliners.slice(0, 3).map((a) => (
                <ArtistCard2015 artist={a} />
              ))}
            </div>

            <div class="hl-grid hl-grid--main">
              {snapshot.lineup.headliners.slice(3).map((a) => (
                <ArtistCard2015 artist={a} />
              ))}
            </div>

            <div class="hl-grid hl-grid--under">
              {snapshot.lineup.undercard.filter((a) => a.image).map((a) => (
                <ArtistCard2015 artist={a} />
              ))}
            </div>

            <ul class="lineup-undercard no-bullets">
              {snapshot.lineup.undercard.filter((a) => !a.image).map((a) => (
                <li>{a.name}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</Fpsf2015Layout>
