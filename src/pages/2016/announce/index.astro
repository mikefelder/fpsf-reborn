---
import Fpsf2016Layout from '@layouts/Fpsf2016Layout.astro';
import snapshot from '@data/snapshot-2016-main.json';
import announce from '@data/home-2016-announce.json';
import type { Snapshot } from '@/types/snapshot';

const data = snapshot as unknown as Snapshot;
const assetBase = '/shared-assets/2016';
const billboards = announce.billboards as Array<{
  type: string;
  image: string;
  href?: string;
  alt?: string;
  title?: string;
  subtitle?: string;
  cta?: string;
}>;
const lineupPanel = billboards.find((b) => b.type === 'lineup');
const otherPanels = billboards.filter((b) => b.type !== 'lineup');
const news = announce.news;
---
<Fpsf2016Layout
  snapshot={data}
  title={announce.title}
  description={announce.description}
  bodyClass="home page page-template-default"
  currentHref="/2016/announce/"
  activeNav=""
  heroBranding={true}
>
  <div class="c-billboard c-billboard--full layout layout--flush">
    {lineupPanel && (
      <div
        class="c-billboard__panel layout__item u-1-of-2-desk desk-one-half c-billboard__panel--lineup c-billboard__lineup--left"
        data-panel-size="50x2"
        style="background-color: #000000;"
      >
        <div class="c-billboard__lineup-inner">
          <div class="c-billboard__lineup-img">
            <a href={lineupPanel.href}>
              <img alt={lineupPanel.alt ?? '2016 lineup'} src={`${assetBase}/${lineupPanel.image}`} />
            </a>
          </div>
          <div class="c-billboard__lineup-share">
            <ul class="list-inline lineup-share-menu">
              <li>
                <a href={`${assetBase}/${lineupPanel.image}`} target="_blank" rel="noopener noreferrer" style="color:#FFFFFF; background-color:#f04841;"><i class="fa fa-2x fa-download"></i></a>
              </li>
              <li class="u-ml">
                <a href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Ffpsf.dev%2F2016%2Flineup%2F" target="_blank" rel="noopener noreferrer" style="color:#FFFFFF; background-color:#f04841;"><i class="fa fa-2x fa-facebook"></i></a>
              </li>
              <li class="u-ml">
                <a href="https://twitter.com/intent/tweet?url=https%3A%2F%2Ffpsf.dev%2F2016%2Flineup%2F" target="_blank" rel="noopener noreferrer" style="color:#FFFFFF; background-color:#f04841;"><i class="fa fa-2x fa-twitter"></i></a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    )}
    {otherPanels.map((panel) => (
      panel.type === 'elist' ? (
        <div class="c-billboard__panel layout__item u-1-of-2-desk desk-one-half c-billboard__panel--elist" data-panel-size="50x2">
          <div
            class="c-billboard__img"
            style={`background-image: url(${assetBase}/${panel.image}); background-position: center center`}
          >
            <div class="c-billboard__elist" style="vertical-align: middle; text-align: center;">
              <h1 class="u-mt0" style="color: #FFFFFF">{panel.title}</h1>
              <div class="c-billboard__elist-form">
                <form class="o-elist js-elist-form" action="#" method="post">
                  <input class="o-elist__input" type="email" name="email" placeholder="jdoe@example.com" />
                  <input type="submit" class="o-elist__submit" value="Join" />
                </form>
                <div class="o-elist-response js-elist-response" data-success="You've subscribed. Stay tuned for more information."></div>
              </div>
            </div>
          </div>
        </div>
      ) : (
        <div class="c-billboard__panel layout__item u-1-of-2-desk desk-one-half c-billboard__panel--imagecopy" data-panel-size="50x2">
          <div
            class="c-billboard__img"
            style={`background-image: url(${assetBase}/${panel.image}); background-position: center center`}
          >
            <div class="c-billboard__copy" style="vertical-align: middle; text-align: center;">
              <h1 class="u-mt0" style="color: #FFFFFF">{panel.title}</h1>
              {panel.subtitle && <h4 class="u-mt0" style="color: #FFFFFF">{panel.subtitle}</h4>}
              {panel.cta && (
                <a href={panel.href} class="btn btn--large btn--ghost" style="border: 3px solid; color: #FFFFFF;">{panel.cta}</a>
              )}
            </div>
          </div>
        </div>
      )
    ))}
  </div>

  {news && (
    <div class="o-wrapper">
      <div class="layout">
        <div class="layout__item">
          <div id="updates" class="c-updates">
            <div class="o-wrapper">
              <div class="layout">
                <div class="layout__item">
                  <div class="layout">
                    <div class="layout__item">
                      <h1 class="c-update__main-title">News &amp; Announcements</h1>
                    </div>
                    <div class="layout__item">
                      <div class="c-update c-update--single">
                        <div class="media">
                          <div class="media__body">
                            <a class="c-update__title" href={news.href}>{news.title}</a>
                            <p class="c-update__date">{news.date}</p>
                            <div class="c-update__excerpt">{news.excerpt}</div>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="layout__item text--center">
                      <a href="/2016/news/" class="btn btn--primary">Read More News</a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  )}
</Fpsf2016Layout>
