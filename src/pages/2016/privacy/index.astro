---
import Fpsf2016Layout from '@layouts/Fpsf2016Layout.astro';
import snapshot from '@data/snapshot-2016-main.json';
import pageHtml from '@data/pages/2016/privacy.html?raw';
import type { Snapshot } from '@/types/snapshot';

const data = snapshot as unknown as Snapshot;
---
<Fpsf2016Layout
  snapshot={data}
  title="Privacy Policy — Free Press Summer Festival 2016"
  description="Privacy policy for Free Press Summer Festival 2016."
  activeNav=""
  currentHref="/2016/privacy/"
>
  <div id="primary">
    <main id="main" class="o-main" role="main">
      <Fragment set:html={pageHtml} />
    </main>
  </div>
</Fpsf2016Layout>
