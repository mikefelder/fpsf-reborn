---
import { liveSnapshots, showYears } from '@data/show-years';

const isDev = import.meta.env.DEV;

// Same pattern as dayfornight-reborn: pick a random live snapshot URL,
// fetch it, and inline its HTML so visitors land on a real FPSF page
// instead of an index. SessionStorage cooldown avoids repeat picks.
const snapshotHrefs = liveSnapshots.map((entry) => entry.href);
const noscriptFallback = [...liveSnapshots].reverse();
---
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{isDev ? 'FPSF reborn — dev index' : 'Free Press Summer Fest — Houston, 2009–2017'}</title>
    <meta name="description" content="Archive rebuild of Free Press Summer Fest (Houston, 2009-2017), reconstructed from raw Wayback captures. Each visit serves a different show-year snapshot." />
    <link rel="canonical" href="https://fpsf.dev/" />
    <meta property="og:title" content="Free Press Summer Fest archive" />
    <meta property="og:description" content="Archive rebuild of Free Press Summer Fest (Houston, 2009-2017)." />
    <meta property="og:site_name" content="Free Press Summer Fest" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://fpsf.dev/" />
    {isDev && (
      <style>
        :root {
          color-scheme: dark;
          --bg: #0f0f12;
          --panel: #18181d;
          --border: #2a2a32;
          --fg: #e8e8ec;
          --muted: #8a8a96;
          --accent: #f97316;
          --planned: #4a4a55;
        }
        * { box-sizing: border-box; }
        body {
          margin: 0;
          padding: 2.5rem 1.5rem 4rem;
          font: 15px/1.5 ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
          background: var(--bg);
          color: var(--fg);
        }
        .container { max-width: 880px; margin: 0 auto; }
        header { margin-bottom: 2rem; }
        h1 {
          margin: 0 0 0.25rem;
          font-size: 1.5rem;
          letter-spacing: -0.01em;
        }
        header p {
          margin: 0;
          color: var(--muted);
          font-size: 0.875rem;
        }
        .year-block {
          background: var(--panel);
          border: 1px solid var(--border);
          border-radius: 8px;
          margin-bottom: 1rem;
          padding: 1rem 1.25rem;
        }
        .year-block.planned { opacity: 0.55; }
        .year-head {
          display: flex;
          align-items: baseline;
          justify-content: space-between;
          gap: 1rem;
          margin-bottom: 0.5rem;
        }
        .year-head .year {
          font-size: 1.125rem;
          font-weight: 600;
          letter-spacing: 0.02em;
        }
        .year-head .edition {
          color: var(--muted);
          font-size: 0.85rem;
        }
        .year-head .status {
          font-size: 0.7rem;
          text-transform: uppercase;
          letter-spacing: 0.08em;
          color: var(--muted);
        }
        .year-block:not(.planned) .status { color: var(--accent); }
        .routes {
          list-style: none;
          padding: 0;
          margin: 0;
          display: grid;
          grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
          gap: 0.5rem;
        }
        .routes a {
          display: block;
          padding: 0.65rem 0.85rem;
          border: 1px solid var(--border);
          border-radius: 6px;
          color: var(--fg);
          text-decoration: none;
          background: rgba(255, 255, 255, 0.02);
          transition: border-color 0.15s, background 0.15s;
        }
        .routes a:hover {
          border-color: var(--accent);
          background: rgba(249, 115, 22, 0.08);
        }
        .routes a code {
          font: 12px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
          color: var(--accent);
          display: block;
          margin-bottom: 0.25rem;
        }
        .routes a .label {
          font-weight: 600;
          font-size: 0.95rem;
        }
        .routes a .desc {
          display: block;
          margin-top: 0.25rem;
          color: var(--muted);
          font-size: 0.78rem;
        }
        .planned-note {
          color: var(--muted);
          font-style: italic;
          font-size: 0.85rem;
        }
        footer {
          margin-top: 3rem;
          padding-top: 1rem;
          border-top: 1px solid var(--border);
          color: var(--muted);
          font-size: 0.78rem;
        }
        footer code { color: var(--accent); }
      </style>
    )}
  </head>
  <body>
    {isDev ? (
      <div class="container">
        <header>
          <h1>FPSF reborn — dev index</h1>
          <p>Random-snapshot landing is disabled in dev. Pick a route to validate.</p>
        </header>
        {showYears.map((show) => (
          <section class={`year-block${show.routes.length === 0 ? ' planned' : ''}`}>
            <div class="year-head">
              <span>
                <span class="year">{show.year}</span>
                {' '}
                <span class="edition">{show.edition}</span>
              </span>
              <span class="status">{show.routes.length === 0 ? 'planned' : `${show.routes.length} route${show.routes.length === 1 ? '' : 's'}`}</span>
            </div>
            {show.routes.length > 0 ? (
              <ul class="routes">
                {show.routes.map((route) => (
                  <li>
                    <a href={route.href}>
                      <code>{route.href}</code>
                      <span class="label">{route.label}</span>
                      {route.description && <span class="desc">{route.description}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="planned-note">Not yet ported.</p>
            )}
          </section>
        ))}
        <footer>
          Production build serves a random snapshot here (20-min sessionStorage cooldown). Set <code>NODE_ENV=production</code> or run <code>npm run build &amp;&amp; npm run preview</code> to see that behavior.
        </footer>
      </div>
    ) : (
      <>
        <noscript>
          <nav>
            <ul>
              {noscriptFallback.map((entry) => (
                <li>
                  <a href={entry.href}>
                    FPSF {entry.year} — {entry.label}
                    {entry.description ? ` (${entry.description})` : ''}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </noscript>

        <script define:vars={{ snapshots: snapshotHrefs }}>
          const storageKey = 'fpsf:snapshot-seen-at-session';
          const cooldownMs = 20 * 60 * 1000;
          const now = Date.now();

          let seenAt = {};
          try {
            const parsed = JSON.parse(sessionStorage.getItem(storageKey) || '{}');
            if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
              seenAt = parsed;
            }
          } catch {
            seenAt = {};
          }

          const candidates = snapshots.filter((s) => {
            const lastSeen = Number(seenAt[s] || 0);
            return now - lastSeen >= cooldownMs;
          });

          // If every snapshot is still in cooldown, pick the least-recently-seen.
          const fallbackPool = [...snapshots].sort((a, b) => {
            const aSeen = Number(seenAt[a] || 0);
            const bSeen = Number(seenAt[b] || 0);
            return aSeen - bSeen;
          });

          const pool = candidates.length > 0 ? candidates : fallbackPool.slice(0, 1);
          const target = pool[Math.floor(Math.random() * pool.length)];

          seenAt[target] = now;
          sessionStorage.setItem(storageKey, JSON.stringify(seenAt));

          fetch(target)
            .then((r) => r.text())
            .then((html) => {
              // Inject <base> so any relative asset paths in the snapshot resolve
              // against the snapshot's directory (most of ours are absolute, but
              // this keeps the convention safe).
              const baseTag = '<base href="' + target + '">';
              html = html.replace(/<head([^>]*)>/i, '<head$1>' + baseTag);
              document.open();
              document.write(html);
              document.close();
              history.replaceState(null, '', '/');
            });
        </script>
      </>
    )}
  </body>
</html>

